{
  "name": "@repo/client-shoptet",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the Shoptet REST API and webhook verification",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "1.16.18",
    "@swc/jest": "0.2.39",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "typescript": "7.0.2"
  }
}
